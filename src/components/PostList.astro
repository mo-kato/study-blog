---
import type { CollectionEntry } from "astro:content";
import { css } from "../../styled-system/css";
import { flex, tagList } from "../../styled-system/patterns";
import Tag from "./Tag.astro";

interface Props {
  posts: CollectionEntry<"posts">[];
}
const { posts } = Astro.props;

const time = css({
  textStyle: "time",
});

const tags = tagList();

const title = css({
  fontSize: "xl",
  fontWeight: "bold",
  mb: 4,
});

const list = css({
  display: "flex",
  flexDir: "column",
  gap: 6,
});

const listItem = flex({
  alignItems: "start",
  direction: "column",
  hairlineBottom: "border",
  pb: 6,
});
---

<ul class={list}>
  {posts
    .sort((a, b) => (a.data.createdAt < b.data.createdAt ? 1 : -1))
    .map(post => 
      <li class={listItem}>
        <time class={time}>
          {Temporal.ZonedDateTime.from(post.data.createdAt).toPlainDate().toString()}
        </time>
        <a class={title} href={`${import.meta.env.BASE_URL}posts/${post.id}/`}>
          {post.data.title}
        </a>
        <div class={tags}>
          {post.data.tags.map(tag => 
            <Tag {tag}/>
          )}
        </div>
      </li>
    )}
</ul>

---
import { css } from "../../styled-system/css";
import { flex } from "../../styled-system/patterns";
import { tagStyle } from "../../styled-system/recipes";

interface Props {
  tag: string;
}
const { tag } = Astro.props;

const tags = tagStyle();
---

<a class={tags.root} href={`${import.meta.env.BASE_URL}/tags/${tag}/`}>
  <span class={tags.label}>{tag}</span>
</a>

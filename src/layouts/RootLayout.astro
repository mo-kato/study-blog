---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import "../index.css";
import { layoutInner } from "../../styled-system/patterns";

const { pageTitle } = Astro.props;
---

<html lang="ja" data-color-mode="dark">
  <head>
    <script is:inline>
    (() => {
      try {
        const stored = localStorage.getItem("theme"); // "light" | "dark" | "system" | null
        const theme = stored ?? "system";
        const resolved =
          theme === "system"
            ? matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : theme;
        document.documentElement.setAttribute("data-color-mode", resolved);
      } catch (_) {}
    })();
    </script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="generator" content={Astro.generator}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono&family=Noto+Sans+JP:wght@100..900&family=Righteous&display=swap"
      rel="stylesheet"
    >
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}/favicon.ico`}
    >
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`}>
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

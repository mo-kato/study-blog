---
import { getCollection } from "astro:content";
import RootLayout from "@layouts/RootLayout.astro";

const pageTitle = "トップページ";

const posts = await getCollection("posts");
---

<RootLayout pageTitle={pageTitle}>
  <ul>
    {posts.map((post) => (
      <li>
        <span>
            {post.data.createdAt}
        </span>
        <a href={`/posts/${post.id}`}>
            {post.data.title}
        </a>
      </li>
  ))}
  </ul>
</RootLayout>
